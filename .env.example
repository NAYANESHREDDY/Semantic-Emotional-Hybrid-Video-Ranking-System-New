# ==============================================================================
# EDUCATIONAL VIDEO RANKING — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your valid API keys.
# NEVER commit your actual API keys or secrets to version control.

# YouTube Data API v3 Key (required for fresh video & comment retrieval in Phase 9A / Phase 13A)
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# Google Gemini API Key (required for LLM Teaching Score & Grounded Explanations)
# Model used: gemini-3.5-flash-lite
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional: Path to root project directory (defaults to current working directory)
PROJECT_ROOT="."
